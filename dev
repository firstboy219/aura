#!/usr/bin/env bash
# AURA task runner (Blueprint E.1 "Makefile or equivalent"). `make` is not installed on the host.
# Every command runs in a throwaway container from the dev image (Python 3.12 + Go 1.26 + uv, deploy/dev.Dockerfile).
# Caches use AURA-only volumes (aura-gomod, aura-uvcache); nothing is shared with other products.
# Usage: ./dev <build|test|test-go|test-py|lint|lock|audit|image|clean> [go test args]   (prefix with sudo if docker needs it)
set -euo pipefail
cd "$(dirname "$0")"
DEV_IMAGE=${DEV_IMAGE:-aura-dev:local}
VERSION=${VERSION:-$(git describe --always --dirty 2>/dev/null || echo dev)}
docker image inspect "$DEV_IMAGE" >/dev/null 2>&1 || docker build -q -f deploy/dev.Dockerfile -t "$DEV_IMAGE" deploy >/dev/null
run() {
  docker run --rm -v "$PWD":/src -v aura-gomod:/root/go/pkg/mod -v aura-uvcache:/root/.cache \
    -e UV_PROJECT_ENVIRONMENT=/tmp/venv -e AURA_REAL_PROVIDER="${AURA_REAL_PROVIDER:-}" \
    -w /src "$DEV_IMAGE" bash -c "$1"
}
PYENV='(cd intelligence/python && uv sync -q --locked) && export PATH=/tmp/venv/bin:$PATH'
shift_args="${*:2}"
case "${1:-}" in
  build)   run "cd core/go && go vet ./... && go build -trimpath -ldflags '-X main.Version=$VERSION' -o /tmp/aura ./cmd/aura && /tmp/aura version" ;;
  test-go) run "$PYENV && cd core/go && go test ${shift_args:-./...}" ;;
  test-py) run "$PYENV && cd intelligence/python && pytest -q" ;;
  test)    run "$PYENV && (cd core/go && go test ./...) && (cd intelligence/python && pytest -q)" ;;
  lint)    run "$PYENV && cd core/go && test -z \"\$(gofmt -l .)\" || { gofmt -l .; exit 1; }; cd /src/intelligence/python && ruff check ." ;;
  fmt)     run "$PYENV && cd core/go && gofmt -w . && cd /src/intelligence/python && ruff check --fix . ; chown -R $(id -u):$(id -g) /src" ;;
  lock)    run "cd intelligence/python && uv lock" ;;
  audit)   run "cd core/go && go mod download && python3 -I /src/deploy/checks/license_audit.py" ;;
  image)   docker build -f deploy/Dockerfile --build-arg VERSION="$VERSION" -t aura-core:local . ;;
  clean)   docker volume rm -f aura-gomod aura-uvcache ;;
  *) echo "usage: ./dev <build|test|test-go|test-py|lint|fmt|lock|audit|image|clean>" >&2; exit 2 ;;
esac
