{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aura.local/contracts/schemas/task.verify.json",
  "title": "task.verify (Core \u2192 Worker)",
  "description": "Assess each completion criterion against the evidence. Core accepts a criterion as met only if its quote is found in the evidence.",
  "type": "object",
  "properties": {
    "params": {
      "type": "object",
      "properties": {
        "objective": {
          "type": "string"
        },
        "completion_criteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "array"
        },
        "tier": {
          "type": "string"
        }
      },
      "required": [
        "objective",
        "completion_criteria",
        "evidence"
      ]
    },
    "result": {
      "type": "object",
      "properties": {
        "criteria": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "criterion": {
                "type": "string"
              },
              "met": {
                "type": "boolean"
              },
              "evidence_quote": {
                "type": "string"
              }
            },
            "required": [
              "criterion",
              "met",
              "evidence_quote"
            ]
          }
        }
      },
      "required": [
        "criteria"
      ]
    }
  }
}
