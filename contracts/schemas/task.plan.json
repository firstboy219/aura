{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aura.local/contracts/schemas/task.plan.json",
  "title": "task.plan (Core → Worker)",
  "description": "Produce plan steps (tool + known arguments) and completion criteria. Side-effect class and tier come from the Core manifest, not the plan.",
  "type": "object",
  "properties": {
    "params": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "objective": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "granted_tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allow_domains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_cost_usd": {
              "type": "number"
            },
            "max_iterations": {
              "type": "integer"
            },
            "max_wall_seconds": {
              "type": "integer"
            }
          },
          "required": [
            "max_cost_usd",
            "max_iterations",
            "max_wall_seconds"
          ]
        },
        "owner_context": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "may_ask": {
          "type": "boolean"
        },
        "tier": {
          "type": "string"
        },
        "attachments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "guidance": {
          "type": "object",
          "description": "Owner-approved L3 guidance per reasoning module (ADR-0048).",
          "additionalProperties": {
            "type": "string",
            "maxLength": 1500
          }
        },
        "tool_docs": {
          "description": "context added in P3 (memory, skills, profile) and P4 (tool docs)"
        },
        "memory": {
          "description": "context added in P3 (memory, skills, profile) and P4 (tool docs)"
        },
        "skills": {
          "description": "context added in P3 (memory, skills, profile) and P4 (tool docs)"
        },
        "profile": {
          "description": "context added in P3 (memory, skills, profile) and P4 (tool docs)"
        },
        "may_answer": {
          "type": "boolean",
          "description": "The plan may have no steps: the owner is then answered from the model's own knowledge, labelled as such (ADR-0055)."
        },
        "conversation": {
          "type": "array",
          "description": "Recent owner/AURA exchanges, oldest first (ADR-0055).",
          "items": {
            "type": "object"
          }
        },
        "self": {
          "type": "string",
          "description": "The Core's deterministic self brief (ADR-0055)."
        },
        "voice": {
          "type": [
            "object",
            "null"
          ],
          "description": "The recognizer's hypotheses when the owner spoke the objective (ADR-0058).",
          "additionalProperties": false,
          "required": [
            "alternatives"
          ],
          "properties": {
            "alternatives": {
              "type": "array",
              "minItems": 1,
              "maxItems": 5,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "text"
                ],
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "confidence": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              }
            }
          }
        }
      },
      "required": [
        "objective",
        "granted_tools",
        "allow_domains",
        "budget"
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 0,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "step_no": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "tool_id": {
                "enum": [
                  "web.fetch",
                  "web.search",
                  "workspace.read",
                  "workspace.write",
                  "data.read",
                  "calc",
                  "wait.event",
                  "wait.until",
                  "agent.delegate",
                  null
                ]
              },
              "url": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 2000
              },
              "path": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 256
              },
              "query": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "expression": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "key": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "until": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "brief": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "tools": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "step_no",
              "description",
              "tool_id"
            ]
          }
        },
        "completion_criteria": {
          "type": "array",
          "minItems": 0,
          "maxItems": 10,
          "items": {
            "type": "string",
            "maxLength": 300
          }
        },
        "question": {
          "type": [
            "string",
            "null"
          ]
        },
        "heard_as": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000,
          "description": "What a spoken objective was understood to mean (ADR-0058)."
        }
      },
      "required": [
        "steps",
        "completion_criteria"
      ]
    }
  }
}
