{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aura.local/contracts/schemas/task.plan.json",
  "title": "task.plan (Core \u2192 Worker)",
  "description": "Produce plan steps (tool + known arguments) and completion criteria. Side-effect class and tier come from the Core manifest, not the plan.",
  "type": "object",
  "properties": {
    "params": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "objective": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "granted_tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allow_domains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_cost_usd": {
              "type": "number"
            },
            "max_iterations": {
              "type": "integer"
            },
            "max_wall_seconds": {
              "type": "integer"
            }
          },
          "required": [
            "max_cost_usd",
            "max_iterations",
            "max_wall_seconds"
          ]
        }
      },
      "required": [
        "objective",
        "granted_tools",
        "allow_domains",
        "budget"
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "step_no": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "tool_id": {
                "enum": [
                  "web.fetch",
                  "workspace.read",
                  "workspace.write",
                  null
                ]
              },
              "url": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 2000
              },
              "path": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 256
              }
            },
            "required": [
              "step_no",
              "description",
              "tool_id",
              "url",
              "path"
            ]
          }
        },
        "completion_criteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "string",
            "maxLength": 300
          }
        }
      },
      "required": [
        "steps",
        "completion_criteria"
      ]
    }
  }
}
