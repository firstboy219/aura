{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aura.local/contracts/schemas/task.step.json",
  "title": "task.step (Core \u2192 Worker)",
  "description": "Execute one planned step. The worker may call llm.complete and at most one tool.invoke for the step's tool; Core re-validates the call against grant, manifest and step.",
  "type": "object",
  "properties": {
    "params": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "objective": {
          "type": "string"
        },
        "step": {
          "$ref": "task.plan.json#/properties/result/properties/steps/items"
        },
        "observations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "step_no": {
                "type": "integer"
              },
              "tool_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "source": {
                "type": "string"
              },
              "trust": {
                "const": "untrusted"
              },
              "content": {
                "type": "string"
              }
            },
            "required": [
              "step_no",
              "tool_id",
              "source",
              "trust",
              "content"
            ]
          }
        },
        "owner_context": {
          "type": "array"
        },
        "tier": {
          "type": "string"
        }
      },
      "required": [
        "objective",
        "step",
        "observations"
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "decision": {
          "enum": [
            "step_done",
            "waiting_approval",
            "waiting",
            "fail"
          ]
        },
        "reason": {
          "type": "string",
          "maxLength": 1000
        }
      },
      "required": [
        "decision",
        "reason"
      ]
    }
  }
}
