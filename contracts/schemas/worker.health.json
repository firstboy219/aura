{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aura.local/contracts/schemas/worker.health.json",
  "title": "worker.health (Core \u2192 Worker)",
  "description": "Liveness probe.",
  "type": "object",
  "properties": {
    "params": {
      "type": "object",
      "additionalProperties": false,
      "properties": {},
      "required": []
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "ok",
            "degraded"
          ]
        },
        "version": {
          "type": "string"
        },
        "rss_bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "status",
        "version"
      ]
    }
  }
}
