{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aura.local/contracts/schemas/llm.complete.json",
  "title": "llm.complete (Worker \u2192 Core)",
  "description": "Model call by logical tier. The worker never names a provider model ID or holds a key.",
  "type": "object",
  "properties": {
    "params": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tier": {
          "enum": [
            "fast",
            "standard",
            "deep"
          ]
        },
        "messages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "role": {
                "enum": [
                  "system",
                  "user",
                  "assistant"
                ]
              },
              "content": {
                "type": "string"
              }
            },
            "required": [
              "role",
              "content"
            ]
          }
        },
        "response_schema": {
          "type": [
            "object",
            "null"
          ],
          "description": "JSON Schema for native structured output (\u00a78.5)"
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32000
        }
      },
      "required": [
        "tier",
        "messages"
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "content": {
          "type": "string"
        },
        "structured": {},
        "provider": {
          "type": "string"
        },
        "route_id": {
          "type": "string"
        },
        "finish_reason": {
          "type": "string"
        }
      },
      "required": [
        "content",
        "provider",
        "route_id"
      ]
    }
  }
}
