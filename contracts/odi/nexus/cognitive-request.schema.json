{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"CognitiveRequest","type":"object","additionalProperties":false,
 "required":["request_id","task_id","session_id","caller","purpose","scope","classification","deadline","idempotency_key","input","context","schema_version"],
 "properties":{"request_id":{"type":"string","format":"uuid"},"task_id":{"type":"string"},"session_id":{"type":"string"},
